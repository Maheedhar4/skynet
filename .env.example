# ── skynet configuration ─────────────────────────────────────────────────────
# Copy to .env at the repo root (parsed by apps/server). Never commit .env.

# REQUIRED — Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model (Gemini free-tier friendly). Override if you hit a 404.
GEMINI_MODEL=gemini-3.5-flash

# Which agent engine to use: "direct" (default, rock-solid genai function
# calling loop) or "adk" (Google ADK TS agent, auto-falls back to direct).
SKYNET_ENGINE=direct

# ── skynet local server ─────────────────────────────────────────────────────
# Main API port (the Angular dev server proxies /api here)
SKYNET_API_PORT=8080
# OAuth redirect callback port. Default 4180 keeps the connect flow 100%
# unprivileged (no root, no sudo): the URI http://localhost:4180/callback is
# registered with Zepto dynamically at connect time and the post-login
# redirect lands directly on skynet. Any port works — URI + listener derive
# from this one knob; only change it on a port conflict.
SKYNET_CALLBACK_PORT=4180
# Where the OAuth flow sends the browser back after /callback handles the code
SKYNET_WEB_ORIGIN=http://localhost:4200
# Storage dir for tokens + chat history (file perms 0600)
SKYNET_DATA_DIR=~/.skynet

# Optional hard override of the redirect URI registered with Zepto. Leave empty
# to derive it from SKYNET_CALLBACK_PORT (http://localhost:${PORT}/callback).
# WARNING: a URI WITHOUT a port (e.g. http://localhost/callback) implies an
# port-80 listener, which needs OS privileges (see README "The callback port").
SKYNET_ZEPTO_REDIRECT_URI=

# Escape-hatch when the callback port can't be bound/reached: complete the
# login by pasting the ?code=... URL Zepto produced into the skynet UI.
# Enabled by default.
SKYNET_ALLOW_PASTE_FALLBACK=1

# ── Session tracing (OpenTelemetry) ──────────────────────────────────────────
# Master switch for the tracing pipeline — the in-app ⏱ Traces drawer included.
# "off" loses nothing but the viewer/export; chat behaves identically.
SKYNET_OTEL=on
# OTLP/HTTP export endpoint. When set (e.g. http://localhost:4318 for
# `docker run -p 4318:4318 jaegertracing/all-in-one`), every trace is ALSO
# mirrored there — open http://localhost:16686 to browse it in the Jaeger UI.
# Works with any OTLP/HTTP collector (Grafana Tempo, Altitude, …).
OTEL_EXPORTER_OTLP_ENDPOINT=
# service.name resource attribute override
SKYNET_OTEL_SERVICE=skynet-server
# Opt-in to embedding prompt/response text in spans. Default off = metadata
# only (tool names, durations, statuses, gate decisions). Tokens never traced.
SKYNET_OTEL_CONTENT=0
