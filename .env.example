# ── skynet configuration ─────────────────────────────────────────────────────
# Copy to .env at the repo root (parsed by apps/server). Never commit .env.

# REQUIRED — Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model (Gemini free-tier friendly). Override if you hit a 404.
GEMINI_MODEL=gemini-2.5-flash

# Which agent engine to use: "direct" (default, rock-solid genai function
# calling loop) or "adk" (Google ADK TS agent, auto-falls back to direct).
SKYNET_ENGINE=direct

# ── skynet local server ─────────────────────────────────────────────────────
# Main API port (the Angular dev server proxies /api here)
SKYNET_API_PORT=8080
# OAuth redirect callback — Zepto whitelists ONLY http://localhost/callback
# and http://localhost (exact match, NO PORTS). So this must be 80.
# Binding port 80 may need one of (documented in README):
#   sudo setcap 'cap_net_bind_service=+ep' $(readlink -f $(which node))
#   sudo apt install authbind && sudo touch /etc/authbind/byport/80 && sudo chmod 777 /etc/authbind/byport/80
SKYNET_CALLBACK_PORT=80
# Where the OAuth flow sends the browser back after /callback handles the code
SKYNET_WEB_ORIGIN=http://localhost:4200
# Storage dir for tokens + chat history (file perms 0600)
SKYNET_DATA_DIR=~/.skynet

# Optional override of the redirect URI registered with Zepto. Leave empty for
# the default http://localhost/callback. Only change this if you registered a
# different URI yourself.
SKYNET_ZEPTO_REDIRECT_URI=

# Escape-hatch when port 80 can't be bound: complete the login by pasting the
# ?code=... URL Zepto produced into the skynet UI. Enabled by default.
SKYNET_ALLOW_PASTE_FALLBACK=1
